# ===================================================
#  VectorDB Environment Configuration
# ===================================================

# Port for the VectorDB HTTP server (Default: 8080)
PORT=8080

# Host and Port for local or remote Ollama instance
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Embedding model (768-dimensional embeddings)
EMBED_MODEL=nomic-embed-text

# Generation LLM model for RAG Question-Answering
GEN_MODEL=llama3.2
